{
  "benchmark_source": {
    "type": "historical_recommendation_eval",
    "path": "./src/historical_recommendation_eval.py"
  },
  "optimization_principle": "lexicographic_holdout_optimization",
  "objective_order": [
    {
      "metric": "error_rate",
      "direction": "minimize"
    },
    {
      "metric": "coverage_skip_rate",
      "direction": "minimize"
    },
    {
      "metric": "anchor_primary_support_adjusted_rate",
      "direction": "maximize"
    },
    {
      "metric": "mean_alignment_score",
      "direction": "maximize"
    },
    {
      "metric": "future_any_support_adjusted_rate",
      "direction": "maximize"
    }
  ],
  "secondary_metrics": [
    "anchor_primary_exact_rate",
    "future_any_exact_rate",
    "strong_alignment_rate"
  ],
  "hard_gates": {
    "action_family_match_required": true,
    "min_weighted_feature_coverage": 0.75,
    "min_critical_feature_coverage": 0.8,
    "critical_features": [
      "state_vector_v1.size_log_revenue",
      "state_vector_v1.gross_obligation_burden",
      "state_vector_v1.net_obligation_burden",
      "state_vector_v1.interest_coverage",
      "state_vector_v1.valuation_multiple"
    ],
    "hard_size_guardrail_log_revenue": 1.5
  },
  "penalty_policies": {
    "regime_mismatch": "explicit_penalty",
    "missingness": "confidence_and_rank_penalty",
    "sector_identity": "soft_penalty"
  },
  "search_space": {
    "group_weights": [
      "identity",
      "valuation",
      "market",
      "macro_regime"
    ],
    "group_weight_grid_values": [
      0.8,
      1.0,
      1.3
    ],
    "within_group_relative_weights": {
      "min": 0.5,
      "max": 2.0
    },
    "optimize_feature_relative_weights": false,
    "optimize_gates": false,
    "optimize_penalties": false,
    "optimize_blend_weights": false
  },
  "regularization": {
    "group_shrinkage": 0.8,
    "feature_shrinkage": 0.9,
    "max_single_feature_share": 0.2,
    "allow_dense_matrix_learning": false
  },
  "search_strategy": {
    "stage_1": "probe_group_weight_search",
    "stage_2": "full_group_weight_search_if_probe_moves",
    "stage_3": "within_group_refinement_after_signal"
  }
}