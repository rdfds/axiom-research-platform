{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NewsRegulatoryEvent",
  "type": "object",
  "description": "Structured regulatory/legal/news events with provenance.",
  "properties": {
    "event_id": { "type": "string" },
    "company_id": { "type": ["string", "null"] },
    "entity_id": { "type": ["string", "null"] },
    "event_type": { "type": "string" },
    "event_subtype": { "type": ["string", "null"] },
    "event_date": { "type": "string", "format": "date-time" },
    "published_at": { "type": "string", "format": "date-time" },
    "effective_at": { "type": ["string", "null"], "format": "date-time" },
    "ingested_at": { "type": "string", "format": "date-time" },
    "materiality_score": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
    "forward_looking_risk_flag": { "type": ["boolean", "null"] },
    "source_id": { "type": "string" },
    "source_type": { "type": "string" },
    "raw_pointer": { "type": "string" },
    "evidence_links": { "type": ["array", "null"], "items": { "type": "string" } },
    "context": { "type": ["string", "null"] }
  },
  "required": [
    "event_id",
    "event_type",
    "event_date",
    "published_at",
    "ingested_at",
    "source_id",
    "source_type",
    "raw_pointer"
  ],
  "additionalProperties": true
}
