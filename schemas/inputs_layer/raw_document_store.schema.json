{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RawDocumentStoreRecord",
  "type": "object",
  "description": "Raw document metadata and pointer to source content.",
  "properties": {
    "document_id": { "type": "string" },
    "source_id": { "type": "string" },
    "source_type": { "type": "string" },
    "entity_id": { "type": ["string", "null"] },
    "entity_id_type": { "type": ["string", "null"] },
    "published_at": { "type": "string", "format": "date-time" },
    "effective_at": { "type": ["string", "null"], "format": "date-time" },
    "ingested_at": { "type": "string", "format": "date-time" },
    "confidence_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "raw_pointer": { "type": "string" },
    "doc_type": { "type": "string" },
    "doc_subtype": { "type": ["string", "null"] },
    "doc_format": { "type": ["string", "null"] },
    "language": { "type": ["string", "null"] },
    "title": { "type": ["string", "null"] },
    "url": { "type": ["string", "null"] },
    "sha256": { "type": ["string", "null"] },
    "content_pointer": { "type": ["string", "null"] },
    "raw_text": { "type": ["string", "null"] },
    "raw_html": { "type": ["string", "null"] },
    "raw_pdf_hash": { "type": ["string", "null"] },
    "content_hash": { "type": ["string", "null"] },
    "version": { "type": ["integer", "null"] },
    "metadata": { "type": ["object", "null"] }
  },
  "required": [
    "document_id",
    "source_id",
    "source_type",
    "entity_id",
    "published_at",
    "ingested_at",
    "confidence_score",
    "raw_pointer",
    "doc_type"
  ],
  "additionalProperties": true
}
