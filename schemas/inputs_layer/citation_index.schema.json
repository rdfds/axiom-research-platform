{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CitationIndex",
  "type": "object",
  "description": "Citation spans linked to extracted facts.",
  "properties": {
    "citation_id": { "type": "string" },
    "fact_id": { "type": "string" },
    "document_id": { "type": "string" },
    "chunk_id": { "type": ["string", "null"] },
    "start_char_offset": { "type": ["integer", "null"] },
    "end_char_offset": { "type": ["integer", "null"] },
    "excerpt_text": { "type": ["string", "null"] },
    "source_id": { "type": ["string", "null"] },
    "source_type": { "type": ["string", "null"] },
    "ingested_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "required": ["citation_id", "fact_id", "document_id"],
  "additionalProperties": true
}
