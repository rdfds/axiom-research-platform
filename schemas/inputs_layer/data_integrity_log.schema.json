{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DataIntegrityLogRecord",
  "type": "object",
  "description": "Validation output for inputs layer checks.",
  "properties": {
    "log_id": { "type": "string" },
    "dataset_name": { "type": "string" },
    "check_name": { "type": "string" },
    "status": { "type": "string" },
    "message": { "type": ["string", "null"] },
    "run_at": { "type": "string", "format": "date-time" },
    "rows_checked": { "type": ["integer", "null"] },
    "failure_count": { "type": ["integer", "null"] },
    "sample_ids": {
      "type": ["array", "null"],
      "items": { "type": "string" }
    },
    "source_id": { "type": ["string", "null"] },
    "source_type": { "type": ["string", "null"] }
  },
  "required": [
    "log_id",
    "dataset_name",
    "check_name",
    "status",
    "run_at"
  ],
  "additionalProperties": true
}
